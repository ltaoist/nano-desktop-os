{
  "name": "nano-desktop-docs",
  "version": "1.0.0",
  "description": "Nano Desktop OS 文档",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.mjs",
    "docs:dev": "npm run copy-assets && vuepress dev docs",
    "docs:build": "npm run copy-assets && vuepress build docs --dest ../docs"
  },
  "devDependencies": {
    "vuepress": "^2.0.0-rc.19",
    "@vuepress/theme-default": "^2.0.0-rc.68",
    "@vuepress/bundler-vite": "^2.0.0-rc.19",
    "@vuepress/plugin-search": "^2.0.0-rc.19",
    "sass-embedded": "^1.77.0"
  }
}
